{
  "info": {
    "name": "Virtual Card Platform",
    "description": "Virtual Card Issuance and Spending API - Complete test collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "cardId",
      "value": "",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Cards",
      "item": [
        {
          "name": "Create Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('cardId', json.id);",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Card is ACTIVE', () => pm.expect(json.status).to.eql('ACTIVE'));",
                  "pm.test('Balance is correct', () => pm.expect(json.balance).to.eql(500.00));",
                  "pm.test('Location header present', () => pm.response.to.have.header('Location'));",
                  "console.log('Created card ID:', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardholderName\": \"Jane Smith\",\n  \"initialBalance\": 500.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards",
              "host": ["{{baseUrl}}"],
              "path": ["cards"]
            },
            "description": "Issues a new virtual card. Saves cardId to collection variable automatically."
          }
        },
        {
          "name": "Create Card - With Custom Expiry",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardholderName\": \"John Doe\",\n  \"initialBalance\": 1000.00,\n  \"expiresAt\": \"2028-12-31T23:59:59\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards",
              "host": ["{{baseUrl}}"],
              "path": ["cards"]
            }
          }
        },
        {
          "name": "Create Card - Zero Balance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardholderName\": \"Empty Wallet\",\n  \"initialBalance\": 0.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards",
              "host": ["{{baseUrl}}"],
              "path": ["cards"]
            }
          }
        },
        {
          "name": "Create Card - Validation Error (blank name)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error is VALIDATION_ERROR', () => pm.expect(pm.response.json().error).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardholderName\": \"\",\n  \"initialBalance\": 100.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards",
              "host": ["{{baseUrl}}"],
              "path": ["cards"]
            }
          }
        },
        {
          "name": "Create Card - Validation Error (negative balance)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardholderName\": \"Test User\",\n  \"initialBalance\": -50.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards",
              "host": ["{{baseUrl}}"],
              "path": ["cards"]
            }
          }
        },
        {
          "name": "Get Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has balance', () => pm.expect(pm.response.json().balance).to.be.a('number'));",
                  "pm.test('Has status', () => pm.expect(pm.response.json().status).to.be.oneOf(['ACTIVE','BLOCKED','CLOSED','EXPIRED']));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}",
              "host": ["{{baseUrl}}"],
              "path": ["cards", "{{cardId}}"]
            },
            "description": "Retrieves card details. Uses cardId saved from Create Card."
          }
        },
        {
          "name": "Get Card - Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error is CARD_NOT_FOUND', () => pm.expect(pm.response.json().error).to.eql('CARD_NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/cards/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["cards", "00000000-0000-0000-0000-000000000000"]
            }
          }
        },
        {
          "name": "Block Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Card is BLOCKED', () => pm.expect(pm.response.json().status).to.eql('BLOCKED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/block",
              "host": ["{{baseUrl}}"],
              "path": ["cards", "{{cardId}}", "block"]
            }
          }
        },
        {
          "name": "Close Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Card is CLOSED', () => pm.expect(pm.response.json().status).to.eql('CLOSED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/close",
              "host": ["{{baseUrl}}"],
              "path": ["cards", "{{cardId}}", "close"]
            }
          }
        }
      ]
    },
    {
      "name": "Spend",
      "item": [
        {
          "name": "Spend - Successful",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', 'spend-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Transaction SUCCESSFUL', () => pm.expect(pm.response.json().status).to.eql('SUCCESSFUL'));",
                  "pm.test('Type is SPEND', () => pm.expect(pm.response.json().type).to.eql('SPEND'));",
                  "pm.test('Amount is correct', () => pm.expect(pm.response.json().amount).to.eql(50.00));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50.00,\n  \"description\": \"Coffee shop purchase\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/spend",
              "host": ["{{baseUrl}}"],
              "path": ["cards", "{{cardId}}", "spend"]
            }
          }
        },
        {
          "name": "Spend - Insufficient Funds (DECLINED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 (not error)', () => pm.response.to.have.status(200));",
                  "pm.test('Transaction DECLINED', () => pm.expect(pm.response.json().status).to.eql('DECLINED'));",
                  "pm.test('Still has transaction ID', () => pm.expect(pm.response.json().id).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 999999.00,\n  \"description\": \"Way too much\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/spend",
              "host": ["{{baseUrl}}"],
              "path": ["cards", "{{cardId}}", "spend"]
            }
          }
        },
        {
          "name": "Spend - Idempotent Retry (same key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns same transaction', () => pm.expect(pm.response.json().status).to.eql('SUCCESSFUL'));",
                  "console.log('This should return the SAME transaction ID as the first spend');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50.00,\n  \"description\": \"Coffee shop purchase\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/spend",
              "host": ["{{baseUrl}}"],
              "path": ["cards", "{{cardId}}", "spend"]
            },
            "description": "Send same Idempotency-Key as the successful spend — must return identical transaction ID."
          }
        },
        {
          "name": "Spend - Zero Amount (validation error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 0.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/spend",
              "host": ["{{baseUrl}}"],
              "path": ["cards", "{{cardId}}", "spend"]
            }
          }
        },
        {
          "name": "Spend - On Blocked Card (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('Error is CARD_NOT_ACTIVE', () => pm.expect(pm.response.json().error).to.eql('CARD_NOT_ACTIVE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/spend",
              "host": ["{{baseUrl}}"],
              "path": ["cards", "{{cardId}}", "spend"]
            },
            "description": "First block the card using Block Card request, then run this."
          }
        }
      ]
    },
    {
      "name": "Top-Up",
      "item": [
        {
          "name": "Top-Up - Successful",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', 'topup-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Transaction SUCCESSFUL', () => pm.expect(pm.response.json().status).to.eql('SUCCESSFUL'));",
                  "pm.test('Type is TOP_UP', () => pm.expect(pm.response.json().type).to.eql('TOP_UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 200.00,\n  \"description\": \"Monthly top-up\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/top-up",
              "host": ["{{baseUrl}}"],
              "path": ["cards", "{{cardId}}", "top-up"]
            }
          }
        },
        {
          "name": "Top-Up - Idempotent Retry",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "console.log('Must return same transaction ID as first top-up');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 200.00,\n  \"description\": \"Monthly top-up\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/top-up",
              "host": ["{{baseUrl}}"],
              "path": ["cards", "{{cardId}}", "top-up"]
            }
          }
        },
        {
          "name": "Top-Up - On Blocked Card (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('Error is CARD_NOT_ACTIVE', () => pm.expect(pm.response.json().error).to.eql('CARD_NOT_ACTIVE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/top-up",
              "host": ["{{baseUrl}}"],
              "path": ["cards", "{{cardId}}", "top-up"]
            },
            "description": "First block the card, then run this to verify 422."
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get Transaction History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "var txns = pm.response.json();",
                  "if (txns.length > 1) {",
                  "  pm.test('Sorted newest first', () => {",
                  "    var first = new Date(txns[0].createdAt);",
                  "    var second = new Date(txns[1].createdAt);",
                  "    pm.expect(first).to.be.at.least(second);",
                  "  });",
                  "}",
                  "console.log('Total transactions:', txns.length);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["cards", "{{cardId}}", "transactions"]
            }
          }
        },
        {
          "name": "Get Transaction History - Unknown Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/cards/00000000-0000-0000-0000-000000000000/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["cards", "00000000-0000-0000-0000-000000000000", "transactions"]
            }
          }
        }
      ]
    },
    {
      "name": "Observability",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/actuator/health",
              "host": ["http://localhost:8080"],
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "Prometheus Metrics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/actuator/prometheus",
              "host": ["http://localhost:8080"],
              "path": ["actuator", "prometheus"]
            },
            "description": "Look for: card_created_total, transaction_spend_total, transaction_topup_total"
          }
        },
        {
          "name": "All Metrics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/actuator/metrics",
              "host": ["http://localhost:8080"],
              "path": ["actuator", "metrics"]
            }
          }
        }
      ]
    }
  ]
}
